<!DOCTYPE html><html lang="en-US"><head><meta http-equiv="Content-Type" content="text/html; charset=UTF-8" /><title>Log In &lsaquo; Riverside Dental Clinic &#8212; WordPress</title><meta name='robots' content='max-image-preview:large, noindex, noarchive' /><link rel='stylesheet' id='dashicons-css' href='https://riverside-dental.example/wp-includes/css/dashicons.min.css?ver=6.4.2' media='all' /><link rel='stylesheet' id='login-css' href='https://riverside-dental.example/wp-admin/css/login.min.css?ver=6.4.2' media='all' /><script src="https://riverside-dental.example/wp-includes/js/jquery/jquery.min.js?ver=3.7.1" id="jquery-core-js"></script><script src="https://riverside-dental.example/wp-includes/js/jquery/jquery-migrate.min.js?ver=3.4.1" id="jquery-migrate-js"></script></head><body class="login no-js login-action-login wp-core-ui locale-en-us"><div id="login"><h1><a href="https://wordpress.org/">Powered by WordPress</a></h1><form name="loginform" id="loginform" action="https://riverside-dental.example/wp-login.php" method="post"><input type="text" name="log" id="user_login" class="input" size="20" autocapitalize="off" /><input type="password" name="pwd" id="user_pass" class="input password-input" size="20" /><input name="rememberme" type="checkbox" id="rememberme" value="forever" /><input type="submit" name="wp-submit" id="wp-submit" class="button button-primary button-large" value="Log In" /></form><p id="nav"><a href="https://riverside-dental.example/wp-login.php?action=lostpassword">Lost your password?</a></p></div></body></html>
